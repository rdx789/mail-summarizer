# mail-with-skills — LLM backend config, per the local-llm-backend skill.
# Copy this file to .env and fill in the values for your machine.

# Which local LLM backend main.py's summarize() uses: "ollama" or "openai_compatible".
LLM_BACKEND=openai_compatible

# Used when LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3.6-35b-a3b

# Used when LLM_BACKEND=openai_compatible — a local llama-server process
# serving a GGUF file (OpenAI-compatible endpoint). run_mail_summarizer.sh
# starts/stops this process for you when LLM_BACKEND=openai_compatible; the
# command below is only for running it manually.
#   llama-server --model "$LLAMA_MODEL_PATH" --port 8080 --ctx-size 16384 --n-gpu-layers 99 --flash-attn on
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=ggml-org/Qwen3.6-35B-A3B-GGUF:Q4_K_M
LLM_API_KEY=not-needed
LLAMA_MODEL_PATH=/path/to/your/models/Qwen3.6-35B-A3B-Q4_K_M.gguf
